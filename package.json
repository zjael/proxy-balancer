{
  "name": "proxy-balancer",
  "version": "3.0.0",
  "description": "Modern TypeScript proxy load balancer with automatic failover and rate limiting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "stress": "node stress_test.js"
  },
  "keywords": [
    "proxy",
    "proxies",
    "balancer",
    "rotater",
    "rotating",
    "load-balancer",
    "proxy-pool",
    "rate-limiting",
    "typescript",
    "failover"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjael/proxy-balancer.git"
  },
  "author": "Jakob Sjælland",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zjael/proxy-balancer/issues"
  },
  "homepage": "https://github.com/zjael/proxy-balancer#readme",
  "dependencies": {
    "bottleneck": "^2.19.5",
    "node-fetch": "^2.6.7",
    "rate-limiter-flexible": "^2.3.12",
    "simple-proxy-agent": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.0.4",
    "axios": "^1.6.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "got": "^11.8.6",
    "prettier": "^3.1.1",
    "tsup": "^8.0.1",
    "tunnel": "^0.0.6",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
